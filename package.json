{
  "name": "cli-launcher-for-claude",
  "displayName": "CLI Launcher for Claude",
  "description": "Run Claude Code CLI in a Webview tab with status icons, session management, and rich terminal features.",
  "version": "3.7.17",
  "publisher": "rockuen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rockuen/cli-launcher-for-claude"
  },
  "icon": "icons/icon-128.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "claudeCodeLauncher.open",
        "title": "Open Claude Code",
        "icon": {
          "light": "./icons/claude-robot-light.svg",
          "dark": "./icons/claude-robot.svg"
        },
        "category": "Claude"
      },
      {
        "command": "claudeCodeLauncher.newClaude",
        "title": "New Claude Session",
        "icon": "$(add)",
        "category": "Claude"
      },
      {
        "command": "claudeCodeLauncher.newKiro",
        "title": "New Kiro Session",
        "icon": "$(add)",
        "category": "Claude"
      },
      {
        "command": "claudeCodeLauncher.newAntigravity",
        "title": "New Antigravity Session",
        "icon": "$(add)",
        "category": "Claude"
      },
      {
        "command": "claudeCodeLauncher.newSession",
        "title": "New Session",
        "icon": "$(add)",
        "category": "Claude"
      },
      {
        "command": "claudeCodeLauncher.renameTab",
        "title": "Rename Claude Code Tab",
        "category": "Claude"
      },
      {
        "command": "claudeCodeLauncher.refreshSessions",
        "title": "%refreshSessions%",
        "icon": "$(refresh)",
        "category": "Claude"
      },
      {
        "command": "claudeCodeLauncher.resumeSession",
        "title": "%resumeSession%",
        "category": "Claude"
      },
      {
        "command": "claudeCodeLauncher.moveToGroup",
        "title": "Move to Group...",
        "icon": "$(folder)",
        "category": "Claude"
      },
      {
        "command": "claudeCodeLauncher.renameGroup",
        "title": "Rename Group",
        "icon": "$(edit)",
        "category": "Claude"
      },
      {
        "command": "claudeCodeLauncher.renameSessionTitle",
        "title": "Rename Session",
        "icon": "$(edit)",
        "category": "Claude"
      },
      {
        "command": "claudeCodeLauncher.trashKiroSession",
        "title": "Move to Trash",
        "icon": "$(trash)",
        "category": "Claude"
      },
      {
        "command": "claudeCodeLauncher.restoreKiroSession",
        "title": "Restore",
        "icon": "$(history)",
        "category": "Claude"
      },
      {
        "command": "claudeCodeLauncher.emptyKiroTrash",
        "title": "Empty Trash",
        "icon": "$(trash)",
        "category": "Claude"
      },
      {
        "command": "claudeCodeLauncher.deleteGroup",
        "title": "Delete Group",
        "icon": "$(trash)",
        "category": "Claude"
      },
      {
        "command": "claudeCodeLauncher.trashSession",
        "title": "Delete",
        "icon": "$(trash)",
        "category": "Claude"
      },
      {
        "command": "claudeCodeLauncher.restoreSession",
        "title": "Restore",
        "icon": "$(history)",
        "category": "Claude"
      },
      {
        "command": "claudeCodeLauncher.emptyTrash",
        "title": "Empty Trash",
        "icon": "$(close-all)",
        "category": "Claude"
      },
      {
        "command": "claudeCodeLauncher.moveSessionUp",
        "title": "Move Up",
        "icon": "$(arrow-up)",
        "category": "Claude"
      },
      {
        "command": "claudeCodeLauncher.moveSessionDown",
        "title": "Move Down",
        "icon": "$(arrow-down)",
        "category": "Claude"
      },
      {
        "command": "claudeCodeLauncher.moveUnderSession",
        "title": "Nest Under Session...",
        "icon": "$(list-tree)",
        "category": "Claude"
      },
      {
        "command": "claudeCodeLauncher.removeSessionParent",
        "title": "Unnest (Move to Top Level)",
        "icon": "$(arrow-left)",
        "category": "Claude"
      },
      {
        "command": "claudeCodeLauncher.moveGroupUp",
        "title": "Move Group Up",
        "icon": "$(arrow-up)",
        "category": "Claude"
      },
      {
        "command": "claudeCodeLauncher.moveGroupDown",
        "title": "Move Group Down",
        "icon": "$(arrow-down)",
        "category": "Claude"
      },
      {
        "command": "claudeCodeLauncher.omc.enter",
        "title": "Enter OMC Mode",
        "category": "Claude"
      },
      {
        "command": "claudeCodeLauncher.omc.exit",
        "title": "Exit OMC Mode",
        "category": "Claude"
      },
      {
        "command": "claudeCodeLauncher.openInMultiplexer",
        "title": "Open Claude Code in tmux/psmux",
        "category": "Claude",
        "enablement": "claudeCodeLauncher.multiplexerAvailable"
      },
      {
        "command": "claudeCodeLauncher.ccg.focus",
        "title": "Show CCG",
        "category": "Claude"
      },
      {
        "command": "claudeCodeLauncher.ccg.refresh",
        "title": "Refresh CCG",
        "icon": "$(refresh)",
        "category": "Claude"
      },
      {
        "command": "claudeCodeLauncher.ccg.openPair",
        "title": "Open CCG Pair",
        "category": "Claude"
      },
      {
        "command": "claudeCodeLauncher.ccg.rerun",
        "title": "Rerun CCG",
        "category": "Claude"
      },
      {
        "command": "claudeCodeLauncher.openTerminal",
        "title": "Open Claude Code (use default backend)",
        "icon": {
          "light": "./icons/claude-robot-light.svg",
          "dark": "./icons/claude-robot.svg"
        },
        "category": "Claude"
      },
      {
        "command": "claudeCodeLauncher.cleanupMultiplexerSessions",
        "title": "Clean Up Detached Multiplexer Sessions",
        "category": "Claude",
        "enablement": "claudeCodeLauncher.multiplexerAvailable"
      },
      {
        "command": "claudeCodeLauncher.resumeSessionInWebview",
        "title": "Resume in Webview",
        "category": "Claude"
      },
      {
        "command": "claudeCodeLauncher.resumeSessionInMultiplexer",
        "title": "Resume in tmux/psmux",
        "category": "Claude",
        "enablement": "claudeCodeLauncher.multiplexerAvailable"
      },
      {
        "command": "claudeCodeLauncher.addSubGroup",
        "title": "Add Sub-Group",
        "icon": "$(new-folder)",
        "category": "Claude"
      },
      {
        "command": "claudeCodeLauncher.toggleGroupArchive",
        "title": "Toggle Archive Mode",
        "icon": "$(archive)",
        "category": "Claude"
      },
      {
        "command": "claudeCodeLauncher.repoSync.setDeviceName",
        "title": "Repo Sync: Set Device Name",
        "category": "Claude"
      },
      {
        "command": "claudeCodeLauncher.repoSync.openSettings",
        "title": "Repo Sync: Open Settings",
        "category": "Claude"
      },
      {
        "command": "claudeCodeLauncher.switchAccount",
        "title": "Switch Claude Account…",
        "category": "Claude"
      },
      {
        "command": "claudeCodeLauncher.saveAccount",
        "title": "Save Current Claude Account as Profile…",
        "category": "Claude"
      },
      {
        "command": "claudeCodeLauncher.diagnostics.dumpNow",
        "title": "Diagnostics: Dump Now",
        "category": "Claude"
      },
      {
        "command": "claudeCodeLauncher.handoffToOther",
        "title": "Claude Launcher: Hand off session to other agent",
        "category": "Claude"
      },
      {
        "command": "claudeCodeLauncher.openSettings",
        "title": "Claude Launcher: Settings",
        "category": "Claude",
        "icon": "$(gear)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claude-code-launcher",
          "title": "CLI Launcher",
          "icon": "./icons/claude-robot.svg"
        }
      ]
    },
    "views": {
      "claude-code-launcher": [
        {
          "id": "claudeCodeLauncher.quickActions",
          "name": "Quick Actions"
        },
        {
          "id": "claudeCodeLauncher.sessionList",
          "name": "Claude Sessions"
        },
        {
          "id": "claudeCodeLauncher.kiroSessions",
          "name": "Kiro Sessions",
          "when": "claudeCodeLauncher.kiroAvailable"
        },
        {
          "id": "claudeCodeLauncher.antigravitySessions",
          "name": "Antigravity Sessions",
          "when": "claudeCodeLauncher.antigravityAvailable"
        },
        {
          "id": "claudeCodeLauncher.ccgPanel",
          "name": "CCG",
          "when": "claudeCodeLauncher.omcModeActive"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "claudeCodeLauncher.sessionList",
        "contents": "%noSessions%"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "claudeCodeLauncher.newClaude",
          "when": "false"
        },
        {
          "command": "claudeCodeLauncher.newKiro",
          "when": "false"
        },
        {
          "command": "claudeCodeLauncher.newAntigravity",
          "when": "false"
        },
        {
          "command": "claudeCodeLauncher.newSession",
          "when": "false"
        },
        {
          "command": "claudeCodeLauncher.openTerminal",
          "when": "false"
        },
        {
          "command": "claudeCodeLauncher.resumeSessionInWebview",
          "when": "false"
        },
        {
          "command": "claudeCodeLauncher.resumeSessionInMultiplexer",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "claudeCodeLauncher.openTerminal",
          "group": "navigation@0"
        }
      ],
      "view/item/context": [
        {
          "command": "claudeCodeLauncher.renameSessionTitle",
          "when": "view == claudeCodeLauncher.sessionList && (viewItem == session || viewItem == subSession)",
          "group": "inline@0"
        },
        {
          "command": "claudeCodeLauncher.moveToGroup",
          "when": "view == claudeCodeLauncher.sessionList && (viewItem == session || viewItem == subSession)",
          "group": "inline@1"
        },
        {
          "command": "claudeCodeLauncher.trashSession",
          "when": "view == claudeCodeLauncher.sessionList && (viewItem == session || viewItem == subSession)",
          "group": "inline@2"
        },
        {
          "command": "claudeCodeLauncher.restoreSession",
          "when": "view == claudeCodeLauncher.sessionList && viewItem == trashed",
          "group": "inline@1"
        },
        {
          "command": "claudeCodeLauncher.renameGroup",
          "when": "view == claudeCodeLauncher.sessionList && viewItem == customGroup",
          "group": "inline@1"
        },
        {
          "command": "claudeCodeLauncher.deleteGroup",
          "when": "view == claudeCodeLauncher.sessionList && viewItem == customGroup",
          "group": "inline@2"
        },
        {
          "command": "claudeCodeLauncher.emptyTrash",
          "when": "view == claudeCodeLauncher.sessionList && viewItem == trashGroup",
          "group": "inline@1"
        },
        {
          "command": "claudeCodeLauncher.moveSessionUp",
          "when": "view == claudeCodeLauncher.sessionList && (viewItem == session || viewItem == subSession)",
          "group": "1_order@1"
        },
        {
          "command": "claudeCodeLauncher.moveSessionDown",
          "when": "view == claudeCodeLauncher.sessionList && (viewItem == session || viewItem == subSession)",
          "group": "1_order@2"
        },
        {
          "command": "claudeCodeLauncher.resumeSessionInWebview",
          "when": "view == claudeCodeLauncher.sessionList && (viewItem == session || viewItem == subSession)",
          "group": "0_resume@1"
        },
        {
          "command": "claudeCodeLauncher.resumeSessionInMultiplexer",
          "when": "view == claudeCodeLauncher.sessionList && (viewItem == session || viewItem == subSession) && claudeCodeLauncher.multiplexerAvailable",
          "group": "0_resume@2"
        },
        {
          "command": "claudeCodeLauncher.moveUnderSession",
          "when": "view == claudeCodeLauncher.sessionList && viewItem == session",
          "group": "2_nest@1"
        },
        {
          "command": "claudeCodeLauncher.removeSessionParent",
          "when": "view == claudeCodeLauncher.sessionList && viewItem == subSession",
          "group": "2_nest@2"
        },
        {
          "command": "claudeCodeLauncher.moveGroupUp",
          "when": "view == claudeCodeLauncher.sessionList && viewItem == customGroup",
          "group": "1_order@1"
        },
        {
          "command": "claudeCodeLauncher.moveGroupDown",
          "when": "view == claudeCodeLauncher.sessionList && viewItem == customGroup",
          "group": "1_order@2"
        },
        {
          "command": "claudeCodeLauncher.addSubGroup",
          "when": "view == claudeCodeLauncher.sessionList && viewItem == customGroup",
          "group": "inline@3"
        },
        {
          "command": "claudeCodeLauncher.toggleGroupArchive",
          "when": "view == claudeCodeLauncher.sessionList && viewItem == customGroup",
          "group": "2_archive@1"
        },
        {
          "command": "claudeCodeLauncher.renameSessionTitle",
          "when": "view == claudeCodeLauncher.kiroSessions && viewItem == kiroSession",
          "group": "inline@0"
        },
        {
          "command": "claudeCodeLauncher.moveToGroup",
          "when": "view == claudeCodeLauncher.kiroSessions && viewItem == kiroSession",
          "group": "inline@1"
        },
        {
          "command": "claudeCodeLauncher.trashKiroSession",
          "when": "view == claudeCodeLauncher.kiroSessions && viewItem == kiroSession",
          "group": "inline@2"
        },
        {
          "command": "claudeCodeLauncher.restoreKiroSession",
          "when": "view == claudeCodeLauncher.kiroSessions && viewItem == kiroTrashed",
          "group": "inline@1"
        },
        {
          "command": "claudeCodeLauncher.emptyKiroTrash",
          "when": "view == claudeCodeLauncher.kiroSessions && viewItem == kiroTrashGroup",
          "group": "inline@1"
        },
        {
          "command": "claudeCodeLauncher.moveSessionUp",
          "when": "view == claudeCodeLauncher.kiroSessions && viewItem == kiroSession",
          "group": "1_order@1"
        },
        {
          "command": "claudeCodeLauncher.moveSessionDown",
          "when": "view == claudeCodeLauncher.kiroSessions && viewItem == kiroSession",
          "group": "1_order@2"
        },
        {
          "command": "claudeCodeLauncher.moveUnderSession",
          "when": "view == claudeCodeLauncher.kiroSessions && viewItem == kiroSession",
          "group": "2_nest@1"
        },
        {
          "command": "claudeCodeLauncher.removeSessionParent",
          "when": "view == claudeCodeLauncher.kiroSessions && viewItem == kiroSession",
          "group": "2_nest@2"
        },
        {
          "command": "claudeCodeLauncher.renameGroup",
          "when": "view == claudeCodeLauncher.kiroSessions && viewItem == customGroup",
          "group": "inline@1"
        },
        {
          "command": "claudeCodeLauncher.deleteGroup",
          "when": "view == claudeCodeLauncher.kiroSessions && viewItem == customGroup",
          "group": "inline@2"
        },
        {
          "command": "claudeCodeLauncher.addSubGroup",
          "when": "view == claudeCodeLauncher.kiroSessions && viewItem == customGroup",
          "group": "inline@3"
        },
        {
          "command": "claudeCodeLauncher.moveGroupUp",
          "when": "view == claudeCodeLauncher.kiroSessions && viewItem == customGroup",
          "group": "1_order@1"
        },
        {
          "command": "claudeCodeLauncher.moveGroupDown",
          "when": "view == claudeCodeLauncher.kiroSessions && viewItem == customGroup",
          "group": "1_order@2"
        },
        {
          "command": "claudeCodeLauncher.renameSessionTitle",
          "when": "view == claudeCodeLauncher.antigravitySessions && viewItem == antigravitySession",
          "group": "inline@0"
        },
        {
          "command": "claudeCodeLauncher.moveToGroup",
          "when": "view == claudeCodeLauncher.antigravitySessions && viewItem == antigravitySession",
          "group": "inline@1"
        },
        {
          "command": "claudeCodeLauncher.moveSessionUp",
          "when": "view == claudeCodeLauncher.antigravitySessions && viewItem == antigravitySession",
          "group": "1_order@1"
        },
        {
          "command": "claudeCodeLauncher.moveSessionDown",
          "when": "view == claudeCodeLauncher.antigravitySessions && viewItem == antigravitySession",
          "group": "1_order@2"
        },
        {
          "command": "claudeCodeLauncher.moveUnderSession",
          "when": "view == claudeCodeLauncher.antigravitySessions && viewItem == antigravitySession",
          "group": "2_nest@1"
        },
        {
          "command": "claudeCodeLauncher.removeSessionParent",
          "when": "view == claudeCodeLauncher.antigravitySessions && viewItem == antigravitySession",
          "group": "2_nest@2"
        },
        {
          "command": "claudeCodeLauncher.renameGroup",
          "when": "view == claudeCodeLauncher.antigravitySessions && viewItem == customGroup",
          "group": "inline@1"
        },
        {
          "command": "claudeCodeLauncher.deleteGroup",
          "when": "view == claudeCodeLauncher.antigravitySessions && viewItem == customGroup",
          "group": "inline@2"
        },
        {
          "command": "claudeCodeLauncher.addSubGroup",
          "when": "view == claudeCodeLauncher.antigravitySessions && viewItem == customGroup",
          "group": "inline@3"
        },
        {
          "command": "claudeCodeLauncher.moveGroupUp",
          "when": "view == claudeCodeLauncher.antigravitySessions && viewItem == customGroup",
          "group": "1_order@1"
        },
        {
          "command": "claudeCodeLauncher.moveGroupDown",
          "when": "view == claudeCodeLauncher.antigravitySessions && viewItem == customGroup",
          "group": "1_order@2"
        }
      ],
      "view/title": [
        {
          "command": "claudeCodeLauncher.openSettings",
          "group": "navigation@0",
          "when": "view == claudeCodeLauncher.quickActions"
        },
        {
          "command": "claudeCodeLauncher.newClaude",
          "group": "navigation@1",
          "when": "view == claudeCodeLauncher.sessionList"
        },
        {
          "command": "claudeCodeLauncher.refreshSessions",
          "group": "navigation@2",
          "when": "view == claudeCodeLauncher.sessionList"
        },
        {
          "command": "claudeCodeLauncher.newKiro",
          "group": "navigation@1",
          "when": "view == claudeCodeLauncher.kiroSessions"
        },
        {
          "command": "claudeCodeLauncher.refreshSessions",
          "group": "navigation@2",
          "when": "view == claudeCodeLauncher.kiroSessions"
        },
        {
          "command": "claudeCodeLauncher.newAntigravity",
          "group": "navigation@1",
          "when": "view == claudeCodeLauncher.antigravitySessions"
        },
        {
          "command": "claudeCodeLauncher.refreshSessions",
          "group": "navigation@2",
          "when": "view == claudeCodeLauncher.antigravitySessions"
        },
        {
          "command": "claudeCodeLauncher.ccg.refresh",
          "group": "navigation@1",
          "when": "view == claudeCodeLauncher.ccgPanel"
        }
      ]
    },
    "configuration": {
      "title": "CLI Launcher for Claude",
      "properties": {
        "claudeCodeLauncher.defaultTheme": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "claude",
            "kiro",
            "antigravity"
          ],
          "enumDescriptions": [
            "Auto — follow each panel's agent (Claude → coral, Kiro → purple, Antigravity → azure)",
            "Claude Dark — coral input tone for every panel",
            "Kiro Purple — purple input tone for every panel",
            "Antigravity Spectrum — azure input tone for every panel"
          ],
          "description": "Input-area accent tone for panels. 'auto' follows the agent of each panel; 'claude'/'kiro'/'antigravity' pin one tone for all panels."
        },
        "claudeCodeLauncher.defaultFontSize": {
          "type": "number",
          "default": 11,
          "minimum": 8,
          "maximum": 22,
          "description": "Default font size (px) for the terminal. Range: 8–22."
        },
        "claudeCodeLauncher.readerFontSize": {
          "type": "number",
          "default": 12,
          "minimum": 10,
          "maximum": 24,
          "description": "Font size (px) for the reader pane (split layout). Child elements (timestamps, metadata, code blocks) scale proportionally via em. Range: 10–24."
        },
        "claudeCodeLauncher.defaultFontFamily": {
          "type": "string",
          "default": "\"D2Coding\", \"D2Coding ligature\", Consolas, monospace",
          "description": "Font family for the terminal. Use CSS font-family syntax."
        },
        "claudeCodeLauncher.soundEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable notification sound when a task completes."
        },
        "claudeCodeLauncher.particlesEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable background particle effects."
        },
        "claudeCodeLauncher.autoEffortMax": {
          "type": "boolean",
          "default": false,
          "description": "Launch Claude sessions with '--effort max' (maximum effort). Toggle in CLI Launcher Settings → Agent. Applies to newly opened and restarted Claude sessions."
        },
        "claudeCodeLauncher.claude.bypassPermissions": {
          "type": "boolean",
          "default": false,
          "description": "Launch Claude sessions with '--dangerously-skip-permissions' (bypass-permissions mode — skips tool/permission prompts). Off by default; use with care. Toggle in CLI Launcher Settings → Agent. Applies to newly opened and restarted Claude sessions."
        },
        "claudeCodeLauncher.pasteToFileThreshold": {
          "type": "number",
          "default": 2000,
          "minimum": 0,
          "description": "Characters above which pasted text is saved to a temp file and referenced via @path to avoid PTY write truncation on Ink/ConPTY line-editors. Set to 0 to disable."
        },
        "claudeCodeLauncher.pasteTableAsMarkdown": {
          "type": "boolean",
          "default": true,
          "description": "When clipboard text is a tab-separated table (e.g. Excel selection), auto-convert it to a Markdown table on paste. Text takes priority over image data, so Excel selections no longer paste as PNG."
        },
        "claudeCodeLauncher.customSlashCommands": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "properties": {
              "cmd": {
                "type": "string",
                "description": "Slash command (e.g. /wrap-up)"
              },
              "desc": {
                "type": "string",
                "description": "Description shown in dropdown"
              }
            },
            "required": [
              "cmd",
              "desc"
            ]
          },
          "description": "Custom slash commands for the autocomplete dropdown. Shareable as JSON."
        },
        "claudeCodeLauncher.slashRegistry.includeBuiltinExtras": {
          "type": "boolean",
          "default": true,
          "description": "Include extra Claude Code built-in slashes (/resume, /usage, /effort, /output-style, /statusline, /security-review, /agents, /mcp, /hooks, /permissions, /ide, /add-dir, /vim, /bug, /install-github-app, /upgrade, /migrate-installer, /release-notes) in the autocomplete dropdown."
        },
        "claudeCodeLauncher.slashRegistry.includePkm": {
          "type": "boolean",
          "default": true,
          "description": "Include PKM project slashes (/blog, /idea, /thinking-partner, /daily-note, /todo, etc., tagged [PKM]) in the autocomplete dropdown. Useful when working inside an Obsidian vault with a .claude/commands folder."
        },
        "claudeCodeLauncher.slashRegistry.includeOmc": {
          "type": "boolean",
          "default": true,
          "description": "Include oh-my-claudecode slashes (/ccg, /team, /ralplan, /deep-interview alias plus /oh-my-claudecode:<skill> namespaced full names, tagged [OMC]) in the autocomplete dropdown."
        },
        "claudeCodeLauncher.terminalMinRows": {
          "type": "number",
          "default": 14,
          "minimum": 3,
          "maximum": 30,
          "description": "Minimum xterm rows guaranteed in split layout. The reader pane cannot grow large enough to shrink the terminal below this row count, so the Claude Code TUI always has room to draw the ctx status line. Default 14 covers Claude Code v2.1+ idle layout (header + prompt + bypass-permissions hint + footer). Splitter drag and saved per-tab ratios both honor this guard. Increase if your TUI still hides the ctx line; decrease if you intentionally want a tiny terminal."
        },
        "claudeCodeLauncher.customButtons": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "description": "Button label"
              },
              "command": {
                "type": "string",
                "description": "Slash command to execute (e.g. /wrap-up)"
              }
            },
            "required": [
              "label",
              "command"
            ]
          },
          "description": "Custom buttons in the input panel. Each button has a label and a slash command."
        },
        "claudeCodeLauncher.multiplexer.preferred": {
          "type": "string",
          "enum": [
            "auto",
            "tmux",
            "psmux",
            "none"
          ],
          "default": "auto",
          "description": "Multiplexer backend selection. 'auto' picks tmux on Mac/Linux and psmux on Windows. 'none' disables multiplexer integration entirely."
        },
        "claudeCodeLauncher.terminal.defaultBackend": {
          "type": "string",
          "enum": [
            "webview",
            "multiplexer"
          ],
          "enumDescriptions": [
            "Default — open Claude Code inside a Webview tab (rich xterm.js terminal, status icons, session save/restore).",
            "Open Claude Code inside a tmux/psmux session. Falls back to webview if no multiplexer is detected."
          ],
          "default": "webview",
          "description": "Backend used by the default 'Open Claude Code' action (keybinding + editor title icon). You can still pick the other mode any time from the command palette ('Open Claude Code' = webview, 'Open Claude Code in tmux/psmux' = multiplexer)."
        },
        "claudeCodeLauncher.terminal.multiplexerLifecycle": {
          "type": "string",
          "enum": [
            "kill-on-close",
            "detached"
          ],
          "enumDescriptions": [
            "Default — kill the tmux/psmux session when the launcher tab closes, matching the webview backend's lifecycle.",
            "Leave the tmux/psmux session detached when the tab closes so you can re-attach it from any external terminal."
          ],
          "default": "kill-on-close",
          "description": "Lifecycle of the tmux/psmux session a multiplexer-backed launcher tab created. 'kill-on-close' avoids zombie sessions (recommended). 'detached' is for power users who want to attach the same session from an external terminal."
        },
        "claudeCodeLauncher.fileAssociations": {
          "type": "object",
          "default": {
            ".csv": "excel",
            ".xlsx": "excel",
            ".xls": "excel",
            ".pptx": "excel",
            ".docx": "system",
            ".pdf": "system",
            ".html": "browser",
            ".htm": "browser",
            ".md": "obsidian",
            ".png": "system",
            ".jpg": "system",
            ".gif": "system",
            ".svg": "system"
          },
          "description": "File extension → open method. Values: 'editor' (IDE), 'system' (OS default), 'obsidian', 'browser', 'excel', or full app path."
        },
        "claudeCodeLauncher.splitLayoutDefault": {
          "type": "boolean",
          "default": false,
          "description": "Show the markdown reader pane above the terminal by default in new tabs. Each tab also has a 👁 toggle in the toolbar that flips this for that tab only."
        },
        "claudeCodeLauncher.repoSync.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable the repo sync feature (file watcher + status bar). Auto-commit/push only fires when repoSync.autoCommit is also true."
        },
        "claudeCodeLauncher.repoSync.path": {
          "type": "string",
          "default": "",
          "description": "Path to the git repo to watch. Supports ${workspaceFolder}, ${userHome}, and ${env:VAR} substitution. Empty falls back to the first IDE workspace folder. Tip: commit \".vscode/settings.json\" in the repo with path set to \"${workspaceFolder}\" so every device auto-resolves to its own absolute path."
        },
        "claudeCodeLauncher.repoSync.autoCommit": {
          "type": "boolean",
          "default": false,
          "description": "Automatically run `git add -A && commit && push` after a debounce window of inactivity. Requires repoSync.enabled. On first use you'll be asked to set a device name (used in commit messages)."
        },
        "claudeCodeLauncher.repoSync.deviceName": {
          "type": "string",
          "default": "",
          "description": "Device name embedded in auto-commit messages, e.g. `[Mac] auto-sync: 2026-05-02 19:42 (3 changes)`. Leave blank to be prompted on first sync. Each device should set this in its own user settings.json (not workspace settings)."
        },
        "claudeCodeLauncher.repoSync.debounceMs": {
          "type": "integer",
          "default": 300000,
          "minimum": 10000,
          "description": "Idle window (ms) after the last file change before auto-commit fires. Default 300000 (5 min)."
        },
        "claudeCodeLauncher.repoSync.extraIgnore": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Additional file/folder patterns to ignore on top of the built-in list. Examples: '**/build/**', '*.cache', 'tmp.*'. Built-in defaults already exclude dot files, node_modules, log/, *.log, *.tmp, sed temp files, and vim swap files."
        },
        "claudeCodeLauncher.diagnostics.enabled": {
          "type": "boolean",
          "default": false,
          "description": "When on, records per-panel PTY chunk statistics (size + inter-arrival histograms) and dumps a memory + counter summary to the 'CLI Launcher — Diagnostics' OutputChannel every 10 minutes. Use this only when investigating a freeze or memory issue — the hot-path cost when off is one null check per PTY chunk. The 'Claude: Diagnostics: Dump Now' command forces a snapshot on demand."
        },
        "claudeCodeLauncher.readerMessageCap": {
          "type": "integer",
          "default": 200,
          "minimum": 20,
          "maximum": 2000,
          "description": "Maximum number of user/assistant messages rendered in the reader pane. Older messages are hidden (the underlying jsonl still holds everything) to keep the reader DOM bounded on long sessions — a 17-panel marathon showed reader-area growing to 10,000+ DOM nodes / 300+ KB on a single panel without this cap. A top indicator line shows the dropped count when truncation kicks in. Default 200 covers typical sessions; raise it if you regularly need more in-pane history, lower it (e.g. 50) if you keep many panels open simultaneously."
        },
        "claudeCodeLauncher.agent": {
          "type": "string",
          "enum": ["claude", "kiro", "antigravity"],
          "default": "claude",
          "description": "Which CLI agent new sessions launch. 'claude' = Claude Code (default). 'kiro' = Kiro CLI (kiro-cli, https://kiro.dev/docs/cli/installation/). 'antigravity' = Antigravity CLI (agy, https://antigravity.google/docs/cli-getting-started). The agent's CLI must be installed."
        },
        "claudeCodeLauncher.enabledAgents": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["claude"],
          "description": "Agents shown when creating a new session. Toggle agents on/off in CLI Launcher Settings → Agent. Only enabled agents that are also installed appear in the new-session picker."
        },
        "claudeCodeLauncher.kiro.trustAllTools": {
          "type": "boolean",
          "default": false,
          "description": "Run Kiro sessions with `kiro-cli chat --trust-all-tools` so Kiro may use any tool without asking for confirmation each time. Off by default (Kiro prompts for permission). Toggle in CLI Launcher Settings → Agent. Applies to newly opened and restarted Kiro sessions."
        },
        "claudeCodeLauncher.antigravity.trustAllTools": {
          "type": "boolean",
          "default": false,
          "description": "Run Antigravity sessions with `agy --dangerously-skip-permissions` so agy auto-approves all tool permission requests without prompting. Off by default (agy asks for confirmation). Toggle in CLI Launcher Settings → Agent. Applies to newly opened and restarted Antigravity sessions."
        }
      }
    },
    "keybindings": [
      {
        "command": "claudeCodeLauncher.openTerminal",
        "key": "ctrl+shift+;",
        "mac": "cmd+shift+;"
      }
    ]
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "marked": "^18.0.3",
    "node-pty": "^1.1.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-search": "^0.13.0",
    "xterm-addon-web-links": "^0.9.0"
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "tsc -p ./ && node esbuild.webview.config.mjs",
    "build:ts": "tsc -p ./",
    "build:webview": "node esbuild.webview.config.mjs",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "clean": "node -e \"require('fs').rmSync('out',{recursive:true,force:true}); require('fs').rmSync('.test-out',{recursive:true,force:true})\"",
    "lint": "tsc -p ./ --noEmit",
    "build:test": "tsc -p ./tsconfig.test.json",
    "test:node": "npm run build:test && node --test .test-out/test/unit/*.test.js",
    "test:vitest": "vitest run",
    "test": "npm run test:node && npm run test:vitest"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.21.0",
    "typescript": "^5.4.0",
    "vitest": "^2.1.9"
  }
}
