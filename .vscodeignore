# ────────────────────────────────────────────────────────────────
# .vscodeignore — runtime-only payload for VSIX
#
# Kept (runtime):
#   extension.js (entry)
#   out/orchestration/**/*.js (tsc + esbuild outputs, no maps)
#   node_modules/<runtime deps>/ (binary / bundles only)
#   package.json, package.nls*, icons/icon-128.png
#   README.md, CHANGELOG.md, LICENSE
#
# Excluded:
#   source (.ts), scripts, build tooling, sourcemaps, repo metadata,
#   node_modules docs/tests
# ────────────────────────────────────────────────────────────────

# --- Git / VCS ---
.git/**
.gitignore
.gitattributes
**/.gitkeep

# --- Source ---
# NOTE: launcher JS (src/*.js, src/panel/, src/pty/, etc.) is REQUIRED AT RUNTIME
# — extension.js does `require('./src/activation')`. Only TypeScript source
# (src/orchestration/**/*.ts) is excluded since it is pre-compiled to out/.
src/**/*.ts
src/**/*.ts.map
scripts/**

# --- Build configuration / tooling ---
tsconfig.json
tsconfig.test.json
esbuild.webview.config.mjs
esbuild.config.mjs

# --- Tests (source + build output, not shipped) ---
test/**
.test-out/**

# --- Local runtime state / editor config ---
.omc/**
.vscode/**
.github/**

# --- Shell helpers (dev-only) ---
install.sh
build.sh

# --- Documentation: keep only README + CHANGELOG ---
*.md
!README.md
!CHANGELOG.md
260322 INSTALL.md

# --- Icons: PNG is used at runtime, SVG source excluded ---
icons/icon-128.svg

# --- VSIX outputs (do not embed previous VSIX) ---
*.vsix

# --- Source maps (runtime does not need them) ---
**/*.map

# --- Windows debug symbols (~55 MB in node-pty prebuilds) ---
**/*.pdb

# --- MSVC incremental build intermediates (win32 node-pty rebuild) ---
# `npx @electron/rebuild` compiles node-pty on the Windows runner and leaves
# ~16 MB of intermediate artifacts under build/ — object files, incremental
# linker databases, MSBuild tracking logs. None are needed at runtime (only
# the compiled .node addons in build/Release/ + the prebuilds/ binaries are).
# Shipping them pushed the win32-x64 vsix to 78 MB unpacked / 23 MB packed,
# over the Open VSX publish gateway's upload timeout (repeated 503s on v3.6.9).
# Excluding them drops the win32 vsix to ~7 MB. darwin/linux builds don't
# produce these files so this is win32-only in effect.
**/*.iobj
**/*.ipdb
**/*.obj
**/*.tlog
**/*.lastbuildstate
**/build/Release/obj/**
**/build/deps/**/obj/**

# --- Trim node_modules metadata / tests / docs ---
node_modules/**/*.md
node_modules/**/*.ts
node_modules/**/test/**
node_modules/**/tests/**
node_modules/**/__tests__/**
node_modules/**/.github/**
node_modules/**/examples/**
node_modules/**/docs/**
node_modules/**/doc/**
node_modules/**/CHANGELOG*
node_modules/**/HISTORY*
node_modules/**/CONTRIBUTING*
node_modules/**/Makefile
node_modules/**/binding.gyp
node_modules/**/tsconfig*.json
node_modules/**/*.d.ts.map
